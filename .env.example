# ---- Postgres / TimescaleDB / Pgvector ----
POSTGRES_USER=ecopulse
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=ecopulse
POSTGRES_HOST=postgres-timescaledb-vector
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis-broker:6379/0

# ---- Backend ----
# Comma-separated API keys protecting write/admin endpoints (send as X-API-Key). Empty = open (dev only).
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
API_KEYS=
# Accounts: set AUTH_REQUIRED=true in production. First admin is created at startup if no users exist.
AUTH_REQUIRED=false
# MLflow tracking (after `make mlflow`): MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_TRACKING_URI=
# Streaming ingestion (after `make streaming`): KAFKA_BROKERS=redpanda:9092
KAFKA_BROKERS=
ADMIN_EMAIL=
ADMIN_PASSWORD=
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_me_long_random_string
CORS_ORIGINS=http://localhost,http://localhost:3000

# ---- LLM providers (used from Phase 3) ----
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.0-flash

# ---- Data sources (used from Phase 2) ----
OPENWEATHER_API_KEY=
CPCB_API_KEY=

# Optional: JSON list of stations to poll, e.g.
# STATIONS_JSON=[{"id":"thorrur-01","city":"Thorrur","lat":17.57,"lon":79.57}]
# (replace lat/lon with exact coordinates; empty = built-in defaults)
STATIONS_JSON=

# ---- Frontend ----
NEXT_PUBLIC_API_BASE=/api/v1
NEXT_PUBLIC_WS_URL=/ws/live-metrics
